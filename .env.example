# Claves de las cadenas (extraídas del bundle público de cada sitio)
# - Cinépolis: buscar x-apikey en https://cinepolis.com
# - Cinemex: buscar X-API-Consumer-Key en https://cinemex.com
CINEPOLIS_API_KEY=your_cinepolis_api_key_here
CINEMEX_API_KEY=your_cinemex_api_key_here

# Telegram. El token lo da BotFather; el chat id del grupo sale de getUpdates.
# El chat id de un grupo es negativo y no siempre empieza con -100.
# TELEGRAM_ALLOWED_USER_IDS es una lista separada por comas.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_GROUP_CHAT_ID=your_group_chat_id_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# IA para /investiga. Se comparten con el proyecto credito.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
