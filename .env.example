# Bot de Telegram (@jc_cine_bot), creado con BotFather.
TELEGRAM_BOT_TOKEN=

# Chat del grupo donde el vigilante publica las alertas (empieza con -100...).
TELEGRAM_GROUP_CHAT_ID=

# IDs numéricos de los únicos usuarios que pueden dar instrucciones al bot.
TELEGRAM_ALLOWED_USER_IDS=

# Gemini (Google AI Studio): motor principal de lenguaje e investigación web.
GEMINI_API_KEY=

# Groq: motor de respaldo cuando se agota la cuota de Gemini. Opcional.
GROQ_API_KEY=
